{
  "manifest_version": 3,
  "name": "Forms Autofill",
  "version": "0.4.0",
  "description": "Fill Google Forms from a saved profile and get AI quiz suggestions you confirm one by one.",
  "permissions": ["storage"],
  "host_permissions": ["https://forms-autofill-proxy.formsautofill.workers.dev/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    { "matches": ["https://docs.google.com/forms/*"], "js": ["content.js"] }
  ]
}
